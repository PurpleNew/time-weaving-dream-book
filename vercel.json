{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/planner/status",
      "destination": "/api/planner/status"
    },
    {
      "source": "/api/planner",
      "destination": "/api/planner"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
